@model CrudEstudiantes.Models.Estudiante

@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<h1>Eliminar Estudiante</h1>

<div class="alert alert-danger">
    <h4>¿Estás seguro de que deseas eliminar este estudiante?</h4>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Apellido)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Matricula)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Matricula)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>