@model IEnumerable<CrudEstudiantes.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
    var buscar = ViewData["Buscar"]?.ToString();
    var hayBusqueda = !string.IsNullOrWhiteSpace(buscar);
}

<div class="page-header">
    <div>
        <h1>Estudiantes</h1>
        <p class="page-sub">Consulta, registra y administra los estudiantes del sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo estudiante</a>
</div>

<form asp-action="Index" method="get" class="search-bar">
    <input type="text" name="buscar" value="@buscar" class="form-control"
           placeholder="Buscar por nombre, apellido, matrícula o correo..." />
    <button type="submit" class="btn btn-primary">Buscar</button>
    @if (hayBusqueda)
    {
        <a asp-action="Index" class="btn btn-soft">Limpiar</a>
    }
</form>

<div class="stat-chip">
    <span class="stat-number">@Model.Count()</span>
    @(hayBusqueda ? "resultado(s) para \"" + buscar + "\"" : "estudiantes registrados")
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        @if (hayBusqueda)
        {
            <h5>Sin resultados</h5>
            <p>No encontramos estudiantes que coincidan con tu búsqueda.</p>
        }
        else
        {
            <h5>Aún no hay estudiantes</h5>
            <p>Registra el primero con el botón "Nuevo estudiante".</p>
        }
    </div>
}
else
{
    <div class="student-grid">
        @foreach (var item in Model)
        {
            <div class="student-card">
                <div class="student-top">
                    <span class="avatar avatar-lg">@(item.Nombre.Length > 0 ? item.Nombre.Substring(0, 1).ToUpper() : "?")@(item.Apellido.Length > 0 ? item.Apellido.Substring(0, 1).ToUpper() : "")</span>
                    <div class="student-name">
                        <h5>@item.Nombre @item.Apellido</h5>
                        <span class="student-id">@item.Matricula</span>
                    </div>
                </div>

                <div class="student-info">
                    <div><span class="info-label">Correo</span> @item.Email</div>
                    <div><span class="info-label">Registro</span> @item.FechaRegistro.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="student-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-soft">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </div>
            </div>
        }
    </div>
}