@model CrudEstudiantes.Models.Estudiante

@{
    ViewData["Title"] = "Detalles del Estudiante";
}

<h1>Detalles del Estudiante</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Nombre @Model.Apellido</h5>
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Matricula)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Matricula)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaRegistro)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaRegistro)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>